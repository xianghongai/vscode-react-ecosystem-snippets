{
  "name": "vscode-react-ecosystem-snippets",
  "displayName": "React Stack Snippets",
  "version": "1.0.2",
  "description": "Everyday React ecosystem snippets: Zustand, Immer, Zod, React Hook Form, TanStack Query, i18n and testing. React 生态高频片段。",
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "i18next",
    "immer",
    "react",
    "react-hook-form",
    "snippets",
    "tanstack-query",
    "zod",
    "zustand"
  ],
  "homepage": "https://github.com/xianghongai/vscode-react-ecosystem-snippets/",
  "bugs": {
    "url": "https://github.com/xianghongai/vscode-react-ecosystem-snippets/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xianghongai/vscode-react-ecosystem-snippets/blob/master/README.md"
  },
  "publisher": "NicholasHsiang",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "clean": "rimraf --glob \"*.vsix\" snippets",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint scripts tests",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "test": "vitest run",
    "vscode:prepublish": "pnpm run clean && pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@vscode/vsce": "3.9.2",
    "ahooks": "^3.9.7",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "i18next": "^26.4.0",
    "immer": "^11.1.18",
    "jotai": "^2.20.3",
    "nuqs": "^2.10.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.4",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.12",
    "react-use": "^17.6.1",
    "rimraf": "^6.1.3",
    "rooks": "^9.9.0",
    "tailwind-merge": "^3.6.0",
    "usehooks-ts": "^3.1.1",
    "vitest": "4.1.11",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "contributes": {
    "snippets": [
      {
        "path": "./snippets/index.code-snippets"
      }
    ]
  },
  "icon": "art/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "packageManager": "pnpm@11.24.0"
}
