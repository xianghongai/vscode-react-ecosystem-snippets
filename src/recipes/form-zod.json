{
	"React Hook Form Zod form file (JavaScript)": {
		"prefix": "rhfZodForm",
		"body": [
			"import { useForm } from 'react-hook-form';",
			"import { zodResolver } from '@hookform/resolvers/zod';",
			"import { z } from 'zod';",
			"import { ${2:createUser} } from './service';",
			"",
			"const userSchema = z.object({",
			"  name: z.string().min(1, 'Enter a name'),",
			"  email: z.email('Enter a valid email'),",
			"});",
			"",
			"export function ${1:UserForm}() {",
			"  const {",
			"    register,",
			"    handleSubmit,",
			"    reset,",
			"    formState: { errors, isSubmitting },",
			"  } = useForm({",
			"    resolver: zodResolver(userSchema),",
			"    defaultValues: { name: '', email: '' },",
			"  });",
			"",
			"  const onSubmit = async (values) => {",
			"    await ${2}(values);",
			"    reset();$0",
			"  };",
			"",
			"  return (",
			"    <form onSubmit={handleSubmit(onSubmit)}>",
			"      <p>",
			"        <label htmlFor=\"user-name\">Name</label>",
			"        <input id=\"user-name\" {...register('name')} aria-invalid={Boolean(errors.name)} />",
			"        {errors.name?.message ? <span role=\"alert\">{errors.name.message}</span> : null}",
			"      </p>",
			"      <p>",
			"        <label htmlFor=\"user-email\">Email</label>",
			"        <input id=\"user-email\" type=\"email\" {...register('email')} aria-invalid={Boolean(errors.email)} />",
			"        {errors.email?.message ? <span role=\"alert\">{errors.email.message}</span> : null}",
			"      </p>",
			"      <button type=\"submit\" disabled={isSubmitting}>Create user</button>",
			"    </form>",
			"  );",
			"}"
		],
		"description": "Complete form file validated by one Zod schema. Requires react-hook-form 7, @hookform/resolvers 5, Zod 4, and a relative ./service module.\n\n由单个 Zod schema 校验的完整表单文件；需要 react-hook-form 7、@hookform/resolvers 5、Zod 4，以及相对路径的 ./service 模块。",
		"scope": "javascriptreact",
		"isFileTemplate": true
	},
