	"React search query file (JavaScript)": {
		"prefix": "reactSearchQuery",
		"body": [
			"import { useEffect, useState } from 'react';",
			"import { useQuery } from '@tanstack/react-query';",
			"import { ${2:searchUsers} } from './service';",
			"",
			"export function ${1:UserSearch}() {",
			"  const [term, setTerm] = useState('');",
			"  const [debouncedTerm, setDebouncedTerm] = useState('');",
			"",
			"  useEffect(() => {",
			"    const timeoutId = window.setTimeout(() => setDebouncedTerm(term.trim()), 300);",
			"    return () => window.clearTimeout(timeoutId);",
			"  }, [term]);",
			"",
			"  const searchQuery = useQuery({",
			"    queryKey: ['${3:users}', 'search', debouncedTerm],",
			"    queryFn: ({ signal }) => ${2}(debouncedTerm, { signal }),",
			"    enabled: debouncedTerm.length > 0,",
			"  });",
			"",
			"  $0",
			"",
			"  return (",
			"    <section aria-label=\"User search\">",
			"      <label htmlFor=\"user-search\">Search users</label>",
			"      <input id=\"user-search\" value={term} onChange={(event) => setTerm(event.target.value)} />",
			"      {searchQuery.isFetching ? <p>Searching…</p> : null}",
			"      {searchQuery.isError ? <p role=\"alert\">Search failed</p> : null}",
			"      <ul>",
			"        {searchQuery.data?.map((user) => <li key={user.id}>{user.name}</li>)}",
			"      </ul>",
			"    </section>",
			"  );",
			"}"
		],
		"description": "Debounced search whose cache key is the debounced term and whose fetch receives the query AbortSignal. Requires an ancestor QueryClientProvider and a relative ./service module.\n\n防抖搜索：缓存键使用防抖后的关键词，请求接收查询的 AbortSignal；需要祖先 QueryClientProvider，以及相对路径的 ./service 模块。",
		"scope": "javascriptreact",
		"isFileTemplate": true
	},
