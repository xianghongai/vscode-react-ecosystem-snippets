{
  "Zustand Immer typed persisted todo store file": {
    "prefix": "zustandImmer",
    "body": [
      "import { create } from 'zustand';",
      "import { devtools, persist } from 'zustand/middleware';",
      "import { immer } from 'zustand/middleware/immer';",
      "",
      "export type ${1:Todo} = {",
      "  id: string;",
      "  title: string;",
      "  done: boolean;",
      "};",
      "",
      "export type ${2:TodoStore} = {",
      "  todos: ${1}[];",
      "  addTodo: (title: string) => void;",
      "  toggleTodo: (id: string) => void;",
      "  removeTodo: (id: string) => void;",
      "  reset: () => void;",
      "};",
      "",
      "const initialTodos: ${1}[] = [];",
      "",
      "export const ${3:useTodoStore} = create<${2}>()(",
      "  devtools(",
      "    persist(",
      "      immer((set) => ({",
      "        todos: initialTodos,",
      "        addTodo: (title) =>",
      "          set((state) => {",
      "            state.todos.push({ id: crypto.randomUUID(), title, done: false });",
      "          }),",
      "        toggleTodo: (id) =>",
      "          set((state) => {",
      "            const todo = state.todos.find((item) => item.id === id);",
      "            if (todo) todo.done = !todo.done;",
      "          }),",
      "        removeTodo: (id) =>",
      "          set((state) => {",
      "            state.todos = state.todos.filter((item) => item.id !== id);",
      "          }),",
      "        reset: () => set({ todos: initialTodos }),",
      "      })),",
      "      {",
      "        name: '${4:todo-store}',",
      "        partialize: (state) => ({ todos: state.todos }),",
      "      },",
      "    ),",
      "    { name: '${2}' },",
      "  ),",
      ");",
      "",
      "$0"
    ],
    "description": "Complete typed store composing Immer drafts, persist partialize, and devtools in the correct order. Requires a secure context for crypto.randomUUID.\n\n按正确顺序组合 Immer draft、persist partialize 与 devtools 的完整类型化 store；需要可用 crypto.randomUUID 的安全上下文。",
    "scope": "typescript,typescriptreact",
    "isFileTemplate": true
  },
