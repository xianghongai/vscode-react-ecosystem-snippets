{
	"React form mutation file (JavaScript)": {
		"prefix": "reactFormMutation",
		"body": [
			"import { useForm } from 'react-hook-form';",
			"import { zodResolver } from '@hookform/resolvers/zod';",
			"import { useMutation, useQueryClient } from '@tanstack/react-query';",
			"import { z } from 'zod';",
			"import { ${2:createUser} } from './service';",
			"",
			"const userSchema = z.object({",
			"  name: z.string().min(1, 'Enter a name'),",
			"  email: z.email('Enter a valid email'),",
			"});",
			"",
			"export function ${1:CreateUserForm}() {",
			"  const queryClient = useQueryClient();",
			"  const form = useForm({",
			"    resolver: zodResolver(userSchema),",
			"    defaultValues: { name: '', email: '' },",
			"  });",
			"  const mutation = useMutation({",
			"    mutationFn: ${2},",
			"    onSuccess: async () => {",
			"      await queryClient.invalidateQueries({ queryKey: ['${3:users}'] });",
			"      form.reset();$0",
			"    },",
			"  });",
			"",
			"  const onSubmit = async (values) => {",
			"    try {",
			"      await mutation.mutateAsync(values);",
			"    } catch (error) {",
			"      const message = error instanceof Error ? error.message : 'Unable to create user';",
			"      form.setError('root.server', { type: 'server', message });",
			"    }",
			"  };",
			"",
			"  return (",
			"    <form onSubmit={form.handleSubmit(onSubmit)}>",
			"      <label htmlFor=\"user-name\">Name</label>",
			"      <input id=\"user-name\" {...form.register('name')} aria-invalid={Boolean(form.formState.errors.name)} />",
			"      {form.formState.errors.name?.message ? <p role=\"alert\">{form.formState.errors.name.message}</p> : null}",
			"      <label htmlFor=\"user-email\">Email</label>",
			"      <input id=\"user-email\" type=\"email\" {...form.register('email')} aria-invalid={Boolean(form.formState.errors.email)} />",
			"      {form.formState.errors.email?.message ? <p role=\"alert\">{form.formState.errors.email.message}</p> : null}",
			"      {form.formState.errors.root?.server?.message ? <p role=\"alert\">{form.formState.errors.root.server.message}</p> : null}",
			"      <button type=\"submit\" disabled={mutation.isPending}>Create user</button>",
			"    </form>",
			"  );",
			"}"
		],
		"description": "Complete submit flow: validate, map a failed submit onto a root error, invalidate the list, then reset. Requires an ancestor QueryClientProvider and a relative ./service module.\n\n完整的提交链路：校验、将提交失败映射为 root 错误、失效列表缓存并重置；需要祖先 QueryClientProvider，以及相对路径的 ./service 模块。",
