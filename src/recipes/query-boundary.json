	"React Query error boundary file (JavaScript)": {
		"prefix": "reactQueryBoundary",
		"body": [
			"import { useQuery, QueryErrorResetBoundary } from '@tanstack/react-query';",
			"import { ErrorBoundary } from 'react-error-boundary';",
			"import { ${2:getUser} } from './service';",
			"",
			"function ${1:UserQueryBoundary}Details({ userId }) {",
			"  const userQuery = useQuery({",
			"    queryKey: ['${3:users}', userId],",
			"    queryFn: ({ signal }) => ${2}(userId, { signal }),",
			"    throwOnError: true,",
			"  });",
			"",
			"  $0",
			"",
			"  if (userQuery.isPending) {",
			"    return <p>Loading user…</p>;",
			"  }",
			"",
			"  return userQuery.data ? <article><h1>{userQuery.data.name}</h1></article> : null;",
			"}",
			"",
			"export function ${1}({ userId }) {",
			"  return (",
			"    <QueryErrorResetBoundary>",
			"      {({ reset }) => (",
			"        <ErrorBoundary",
			"          onReset={reset}",
			"          fallbackRender={({ resetErrorBoundary }) => (",
			"            <section role=\"alert\">",
			"              <p>Unable to load the user.</p>",
			"              <button type=\"button\" onClick={resetErrorBoundary}>Try again</button>",
			"            </section>",
			"          )}",
			"        >",
			"          <${1}Details userId={userId} />",
			"        </ErrorBoundary>",
			"      )}",
			"    </QueryErrorResetBoundary>",
			"  );",
			"}"
		],
		"description": "Throw query failures to an error boundary and let QueryErrorResetBoundary drive the retry. Requires react-error-boundary, an ancestor QueryClientProvider, and a relative ./service module.\n\n将查询失败抛给错误边界，并由 QueryErrorResetBoundary 驱动重试；需要 react-error-boundary、祖先 QueryClientProvider，以及相对路径的 ./service 模块。",
		"scope": "javascriptreact",
		"isFileTemplate": true
	},
