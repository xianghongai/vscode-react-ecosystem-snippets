{
	"React Query Zod boundary file (JavaScript)": {
		"prefix": "reactQueryZod",
		"body": [
			"import { useQuery } from '@tanstack/react-query';",
			"import { z } from 'zod';",
			"import { ${2:getUser} } from './service';",
			"",
			"const userSchema = z.object({",
			"  id: z.string(),",
			"  name: z.string(),",
			"  email: z.email(),",
			"});",
			"",
			"export function ${1:UserDetails}({ userId }) {",
			"  const userQuery = useQuery({",
			"    queryKey: ['${3:users}', userId],",
			"    queryFn: async ({ signal }) => userSchema.parse(await ${2}(userId, { signal })),",
			"  });",
			"",
			"  $0",
			"",
			"  if (userQuery.isPending) {",
			"    return <p>Loading user…</p>;",
			"  }",
			"",
			"  if (userQuery.isError) {",
			"    const message = userQuery.error instanceof Error ? userQuery.error.message : 'Unable to load user';",
			"    return <p role=\"alert\">{message}</p>;",
			"  }",
			"",
			"  return <article><h1>{userQuery.data.name}</h1><p>{userQuery.data.email}</p></article>;",
			"}"
		],
		"description": "Validate a service response at the query boundary, so bad data never reaches the component. Requires an ancestor QueryClientProvider and a relative ./service module.\n\n在查询边界校验服务响应，使非法数据不会进入组件；需要祖先 QueryClientProvider，以及相对路径的 ./service 模块。",
		"scope": "javascriptreact",
		"isFileTemplate": true
	},
