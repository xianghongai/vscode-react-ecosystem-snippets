{
  "TanStack Query paginated query (JavaScript)": {
    "prefix": "queryPagination",
    "body": [
      "export function ${1:UserPage}() {",
      "  const [${2:page}, ${3:setPage}] = useState(1);",
      "  const ${4:usersQuery} = useQuery({",
      "    queryKey: ['${5:users}', { ${2} }],",
      "    queryFn: ({ signal }) => ${6:getUsers}({ ${2}, signal }),",
      "    placeholderData: keepPreviousData,",
      "  });",
      "",
      "  return (",
      "    <section aria-label=\"${7:Users}\">",
      "      <ul>",
      "        {${4}.data?.items.map((item) => <li key={item.id}>{item.name}</li>)}",
      "      </ul>",
      "      <button type=\"button\" onClick={() => ${3}((current) => Math.max(1, current - 1))} disabled={${2} === 1}>",
      "        Previous",
      "      </button>",
      "      <span aria-live=\"polite\">Page {${2}}</span>",
      "      <button type=\"button\" onClick={() => ${3}((current) => current + 1)} disabled={${4}.isPlaceholderData}>",
      "        Next",
      "      </button>",
      "      $0",
      "    </section>",
      "  );",
      "}"
    ],
    "description": "Paginate while keeping the previous page visible during a fetch. Requires useState from react plus useQuery and keepPreviousData from @tanstack/react-query.\n\n分页时保留上一页内容，避免请求期间闪烁；需要 react 的 useState，以及 @tanstack/react-query 的 useQuery、keepPreviousData。",
    "scope": "javascriptreact"
  },
