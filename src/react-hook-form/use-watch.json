{
  "React Hook Form useWatch preview (JavaScript)": {
    "prefix": "useWatch",
    "body": [
      "export function ${1:DisplayNamePreview}() {",
      "  const { control, register } = useForm({",
      "    defaultValues: { firstName: '', lastName: '' },",
      "  });",
      "  const [firstName, lastName] = useWatch({",
      "    control,",
      "    name: ['firstName', 'lastName'],",
      "  });",
      "",
      "  return (",
      "    <section aria-label=\"${2:Display name preview}\">",
      "      <p>{[firstName, lastName].filter(Boolean).join(' ') || 'Add your name'}</p>",
      "      <label htmlFor=\"first-name\">First name</label>",
      "      <input id=\"first-name\" {...register('firstName')} />",
      "      <label htmlFor=\"last-name\">Last name</label>",
      "      <input id=\"last-name\" {...register('lastName')} />",
      "    </section>",
      "  );",
      "}",
      "$0"
    ],
    "description": "Subscribe to selected fields so only this subtree re-renders. Requires useForm and useWatch from react-hook-form.\n\n订阅选定字段，使重渲染局限在该子树；需要从 react-hook-form 导入 useForm 和 useWatch。",
    "scope": "javascriptreact"
  },
