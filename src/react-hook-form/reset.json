{
	"React Hook Form reset loaded data (JavaScript)": {
		"prefix": "rhfReset",
		"body": [
			"export function ${1:ProfileEditor}() {",
			"  const { register, reset } = useForm({",
			"    defaultValues: { name: '', email: '' },",
			"  });",
			"",
			"  useEffect(() => {",
			"    let active = true;",
			"",
			"    void ${2:loadProfile}().then((profile) => {",
			"      if (active) {",
			"        reset(profile);",
			"      }",
			"    });",
			"",
			"    return () => {",
			"      active = false;",
			"    };",
			"  }, [reset]);",
			"",
			"  return (",
			"    <form>",
			"      <label htmlFor=\"profile-name\">Name</label>",
			"      <input id=\"profile-name\" {...register('name')} />",
			"      <label htmlFor=\"profile-email\">Email</label>",
			"      <input id=\"profile-email\" type=\"email\" {...register('email')} />",
			"    </form>",
			"  );",
			"}",
			"$0"
		],
		"description": "Backfill a form once its data resolves, ignoring a response that arrives after unmount. Requires useEffect from react, useForm from react-hook-form, and a loader returning the form values.\n\n数据返回后回填表单，并忽略卸载后才到达的响应；需要 react 的 useEffect、react-hook-form 的 useForm，以及返回表单值的加载函数。",
		"scope": "javascriptreact"
	},
	"React Hook Form reset loaded data (TypeScript)": {
		"prefix": "rhfReset",
		"body": [
			"export function ${1:ProfileEditor}() {",
			"  const { register, reset } = useForm<${2:ProfileForm}>({",
			"    defaultValues: { name: '', email: '' },",
			"  });",
			"",
			"  useEffect(() => {",
			"    let active = true;",
			"",
			"    void ${3:loadProfile}().then((profile) => {",
			"      if (active) {",
			"        reset(profile);",
			"      }",
			"    });",
			"",
			"    return () => {",
			"      active = false;",
			"    };",
			"  }, [reset]);",
			"",
			"  return (",
			"    <form>",
			"      <label htmlFor=\"profile-name\">Name</label>",
			"      <input id=\"profile-name\" {...register('name')} />",
			"      <label htmlFor=\"profile-email\">Email</label>",
			"      <input id=\"profile-email\" type=\"email\" {...register('email')} />",
			"    </form>",
			"  );",
			"}",
			"$0"
		],
		"description": "Backfill a typed form once its data resolves, ignoring a response that arrives after unmount. Requires useEffect from react, useForm from react-hook-form, the form value type in scope, and a loader returning it.\n\n数据返回后回填类型化表单，并忽略卸载后才到达的响应；需要 react 的 useEffect、react-hook-form 的 useForm，在作用域中提供表单值类型，以及返回该类型的加载函数。",
		"scope": "typescriptreact"
	}
}
