{
  "React Hook Form setError root and field (JavaScript)": {
    "prefix": "rhfSetError",
    "body": [
      "export function ${1:AccountForm}() {",
      "  const {",
      "    handleSubmit,",
      "    register,",
      "    setError,",
      "    formState: { errors },",
      "  } = useForm({",
      "    defaultValues: { email: '' },",
      "  });",
      "",
      "  const onSubmit = async (values) => {",
      "    try {",
      "      await ${2:saveAccount}(values);",
      "    } catch (error) {",
      "      const message = error instanceof Error ? error.message : 'Unable to save account';",
      "      setError('email', { type: 'server', message });",
      "      setError('root.server', { type: 'server', message });",
      "    }",
      "  };",
      "",
      "  return (",
      "    <form onSubmit={handleSubmit(onSubmit)}>",
      "      <label htmlFor=\"account-email\">Email</label>",
      "      <input id=\"account-email\" type=\"email\" {...register('email')} />",
      "      {errors.email?.message ? <p role=\"alert\">{errors.email.message}</p> : null}",
      "      {errors.root?.server?.message ? <p role=\"alert\">{errors.root.server.message}</p> : null}",
      "      <button type=\"submit\">${3:Save account}</button>",
      "    </form>",
      "  );",
      "}",
      "$0"
    ],
    "description": "Map a rejected submit onto both the offending field and a form-level root error. Requires useForm from react-hook-form and a submit handler that may reject.\n\n将提交失败同时映射到对应字段和表单级 root 错误；需要从 react-hook-form 导入 useForm，以及可能失败的提交函数。",
    "scope": "javascriptreact"
  },
