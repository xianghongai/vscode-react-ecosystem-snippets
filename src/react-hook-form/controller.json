{
  "React Hook Form Controller native select (JavaScript)": {
    "prefix": "rhfController",
    "body": [
      "export function ${1:SettingsFormFields}() {",
      "  const { control, handleSubmit } = useForm({",
      "    defaultValues: { plan: 'starter' },",
      "  });",
      "",
      "  const onSubmit = (values) => {",
      "    console.log(values);",
      "  };",
      "",
      "  return (",
      "    <form onSubmit={handleSubmit(onSubmit)}>",
      "      <label htmlFor=\"plan\">Plan</label>",
      "      <Controller",
      "        control={control}",
      "        name=\"plan\"",
      "        render={({ field, fieldState }) => (",
      "          <>",
      "            <select id=\"plan\" {...field} aria-invalid={fieldState.invalid}>",
      "              <option value=\"starter\">Starter</option>",
      "              <option value=\"team\">Team</option>",
      "            </select>",
      "            {fieldState.error ? <p role=\"alert\">{fieldState.error.message}</p> : null}",
      "          </>",
      "        )}",
      "      />",
      "      <button type=\"submit\">${2:Save settings}</button>",
      "    </form>",
      "  );",
      "}",
      "$0"
    ],
    "description": "Bind a non-native or wrapped input through Controller. Requires Controller and useForm from react-hook-form.\n\n通过 Controller 绑定非原生或被包装的输入控件；需要从 react-hook-form 导入 Controller 和 useForm。",
    "scope": "javascriptreact"
  },
